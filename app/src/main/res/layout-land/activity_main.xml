<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_bg_screen"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        tools:context=".MainActivity">

        <!-- CỘT TRÁI -->
        <LinearLayout
            android:id="@+id/leftColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="8dp">

            <!-- BANNER -->
            <ImageView
                android:id="@+id/imageView"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:contentDescription="Ảnh giới thiệu khóa học Android" />

            <!-- THÔNG TIN KHÓA HỌC -->
            <LinearLayout
                android:id="@+id/LinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:padding="16dp"
                android:background="@color/color_surface">

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chuyên Đề Lập Trình Android Native Chuyên Sâu: Kiến Trúc Clean Architecture &amp; Jetpack 2026"
                    android:textSize="22sp"
                    android:textColor="@color/color_text_title"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:breakStrategy="high_quality" />

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="3.500.000 VNĐ"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_primary" />

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Thời lượng: 12 buổi (36 giờ học)"
                    android:textSize="13sp"
                    android:textColor="@color/color_text_body" />

            </LinearLayout>

        </LinearLayout>

        <!-- CỘT PHẢI -->
        <LinearLayout
            android:id="@+id/rightColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp">

            <!-- THÔNG TIN NGƯỜI THAM DỰ -->
            <LinearLayout
                android:id="@+id/LinearLayout2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp"
                android:background="@color/color_surface">

                <EditText
                    android:id="@+id/editText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:layout_margin="12dp"
                    android:hint="Nhập họ và tên học viên"
                    android:textColorHint="@color/color_text_hint"
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:background="@android:drawable/editbox_background_normal" />

                <EditText
                    android:id="@+id/editText2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:layout_margin="12dp"
                    android:hint="Nhập email nhận vé điện tử"
                    android:textColorHint="@color/color_text_hint"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:background="@android:drawable/editbox_background_normal" />

                <EditText
                    android:id="@+id/editText3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="14dp"
                    android:layout_margin="12dp"
                    android:hint="Số điện thoại liên hệ"
                    android:textColorHint="@color/color_text_hint"
                    android:inputType="phone"
                    android:imeOptions="actionDone"
                    android:background="@android:drawable/editbox_background_normal" />

            </LinearLayout>

            <!-- LỰA CHỌN CA HỌC -->
            <LinearLayout
                android:id="@+id/LinearLayout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="@color/color_surface">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="LỰA CHỌN CA HỌC"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_title"
                    android:layout_marginBottom="4dp" />

                <RadioGroup
                    android:id="@+id/radioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ca Sáng (08:30 - 11:30)"
                        android:textColor="@color/color_text_body"
                        android:checked="true" />

                    <RadioButton
                        android:id="@+id/radioButton2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ca Chiều (14:00 - 17:00)"
                        android:textColor="@color/color_text_body" />

                    <RadioButton
                        android:id="@+id/radioButton3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ca Tối (18:30 - 21:30)"
                        android:textColor="@color/color_text_body" />

                </RadioGroup>

            </LinearLayout>
            <LinearLayout
                android:id="@+id/LinearLayout4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="@color/color_surface">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DỊCH VỤ GIA TĂNG"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_text_title"
                    android:layout_marginBottom="4dp" />

                <CheckBox
                    android:id="@+id/checkBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nhận giáo trình bìa cứng in màu tại lớp (+150.000đ)"
                    android:textColor="@color/color_text_body"
                    android:checked="false" />

                <CheckBox
                    android:id="@+id/checkBox2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gói cố vấn nghề nghiệp 1-1 với Senior Engineer (+500.000đ)"
                    android:textColor="@color/color_text_body"
                    android:checked="false" />

            </LinearLayout>

            <!-- ĐIỀU KHOẢN VÀ THANH TOÁN -->
            <LinearLayout
                android:id="@+id/LinearLayout5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="12dp"
                android:padding="12dp"
                android:background="@color/color_surface">

                <CheckBox
                    android:id="@+id/checkBox3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Tôi cam kết tham gia đầy đủ các buổi học và tuân thủ nội quy đào tạo"
                    android:textSize="13sp"
                    android:textColor="@color/color_text_body"
                    android:checked="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="XÁC NHẬN ĐẶT CHỖ &amp; THANH TOÁN"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/color_surface"
                    android:backgroundTint="@color/color_primary"
                    android:elevation="4dp"
                    app:cornerRadius="12dp"
                    app:icon="@android:drawable/ic_menu_send"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
